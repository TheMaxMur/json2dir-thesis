// A filesystem compiler written entirely in Typst. No plugins or foreign code.

#let failure(code, path, message) = (
  ok: false, nodes: (), error: (code: code, path: path, message: message),
)

#let check-name(name, parent: ".") = {
  if name == "" or name == "." or name == ".." {
    return failure("invalid-name", parent, "Expected a non-special, non-empty filename")
  }
  if name.contains("/") {
    return failure("invalid-name", parent, "Names must have exactly one path component")
  }
  if name.contains("\u{0}") {
    return failure("invalid-name", parent, "A filename cannot contain a NUL byte")
  }
  (ok: true,)
}

// An explicit work stack avoids recursive function calls for nested directories.
// A successful result is a deterministic, sorted, preorder operation sequence.
#let plan(tree) = {
  if type(tree) != dictionary {
    return failure("invalid-root", ".", "Expected the JSON document to be an object")
  }
  let pending = ((path: ".", value: tree, root: true),)
  let nodes = ()
  while pending.len() > 0 {
    let item = pending.pop()
    let value = item.value
    let kind = type(value)
    if kind == dictionary {
      if not item.root {
        nodes.push((kind: "directory", path: item.path, payload: none))
      }
      for name in value.keys().sorted().rev() {
        let checked = check-name(name, parent: item.path)
        if not checked.ok { return checked }
        pending.push((path: item.path + "/" + name, value: value.at(name), root: false))
      }
    } else if kind == str {
      nodes.push((kind: "file", path: item.path, payload: value))
    } else if kind == array {
      if value.len() != 2 or type(value.at(0)) != str or type(value.at(1)) != str {
        return failure("invalid-array", item.path,
          "Expected an array of two strings: [kind, payload]")
      }
      let tag = value.at(0)
      let payload = value.at(1)
      if tag != "link" and tag != "script" {
        return failure("invalid-kind", item.path,
          "Expected array kind to be link or script")
      }
      if tag == "link" and payload.contains("\u{0}") {
        return failure("invalid-target", item.path,
          "A symbolic-link target cannot contain a NUL byte")
      }
      nodes.push((kind: tag, path: item.path, payload: payload))
    } else {
      return failure("invalid-node", item.path,
        "Expected an object, string, or tagged array")
    }
  }
  (ok: true, nodes: nodes, error: none)
}

#let require-plan(tree) = {
  let result = plan(tree)
  if not result.ok {
    panic(result.error.code + " at " + repr(result.error.path)
      + ": " + result.error.message)
  }
  result.nodes
}

// POSIX shell single-quote encoding. Data is never interpreted as shell source.
#let shell-quote(value) = "'" + value.replace("'", "'\\''") + "'"

// printf %b accepts \0ooo. Encoding every UTF-8 byte also preserves embedded
// NULs in file contents, literal backslashes, and all trailing newlines.
#let octal(value) = {
  let data = bytes(value)
  let digits = "01234567"
  let encoded = ()
  for index in range(data.len()) {
    let n = data.at(index)
    encoded.push("\\0" + digits.at(calc.floor(n / 64))
      + digits.at(calc.rem(calc.floor(n / 8), 8)) + digits.at(calc.rem(n, 8)))
  }
  if encoded.len() == 0 { "" } else { encoded.join() }
}

#let emit-shell(nodes) = {
  let lines = ("#!/bin/sh",
    "# Generated by json2dir in Typst. Run inside the destination directory.",
    "set -eu")
  for node in nodes {
    let path = shell-quote(node.path)
    // Like upstream remove_file: remove files and links, leave directories.
    lines.push("rm -f -- " + path + " 2>/dev/null || :")
    if node.kind == "directory" {
      lines.push("if [ ! -d " + path + " ]; then mkdir -- " + path + "; fi")
      lines.push("[ ! -L " + path + " ] || { printf '%s\\n' "
        + "'Refusing a directory symlink' >&2; exit 1; }")
    } else if node.kind == "link" {
      lines.push("[ ! -d " + path + " ] || { printf '%s\\n' "
        + "'Cannot replace a directory with a symlink' >&2; exit 1; }")
      lines.push("ln -s -- " + shell-quote(node.payload) + " " + path)
    } else {
      lines.push("printf '%b' " + shell-quote(octal(node.payload)) + " > " + path)
      if node.kind == "script" { lines.push("chmod a+x " + path) }
    }
  }
  lines.join("\n") + "\n"
}

#let statistics(nodes) = (
  total: nodes.len(),
  directories: nodes.filter(n => n.kind == "directory").len(),
  files: nodes.filter(n => n.kind == "file").len(),
  links: nodes.filter(n => n.kind == "link").len(),
  scripts: nodes.filter(n => n.kind == "script").len(),
  payload-bytes: nodes.filter(n => n.payload != none)
    .fold(0, (sum, n) => sum + bytes(n.payload).len()),
)
