// All compiler unit tests are themselves written in Typst.
#import "../src/lib.typ": plan, check-name, shell-quote, octal, emit-shell, statistics
#let checks = (
  (() => assert(plan((:)).ok)),
  (() => assert.eq(plan((:)).nodes, ())),
  (() => assert.eq(plan(3).error.code, "invalid-root")),
  (() => assert.eq(plan(()).error.code, "invalid-root")),
  (() => assert.eq(plan((a: false)).error.code, "invalid-node")),
  (() => assert.eq(plan((a: none)).error.code, "invalid-node")),
  (() => assert.eq(plan((a: 1.5)).error.code, "invalid-node")),
  (() => assert.eq(plan((a: ())).error.code, "invalid-array")),
  (() => assert.eq(plan((a: ("link",))).error.code, "invalid-array")),
  (() => assert.eq(plan((a: ("link", "x", "y"))).error.code, "invalid-array")),
  (() => assert.eq(plan((a: (2, "x"))).error.code, "invalid-array")),
  (() => assert.eq(plan((a: ("link", 2))).error.code, "invalid-array")),
  (() => assert.eq(plan((a: ("unknown", "x"))).error.code, "invalid-kind")),
  (() => assert.eq(plan((a: ("link", "\u{0}"))).error.code, "invalid-target")),
  (() => assert.eq(check-name("").error.code, "invalid-name")),
  (() => assert.eq(check-name(".").error.code, "invalid-name")),
  (() => assert.eq(check-name("..").error.code, "invalid-name")),
  (() => assert.eq(check-name("/").error.code, "invalid-name")),
  (() => assert.eq(check-name("a/b").error.code, "invalid-name")),
  (() => assert.eq(check-name("a\u{0}b").error.code, "invalid-name")),
  (() => assert(check-name("a\\b").ok)),
  (() => assert(check-name("-rf").ok)),
  (() => assert(check-name("a'b\n$c").ok)),
  (() => assert.eq(shell-quote("a'b"), "'a'\\''b'")),
  (() => assert.eq(octal("A\n\u{0}"), "\\0101\\0012\\0000")),
  (() => assert.eq(octal(""), "")),
  (() => assert.eq(octal("é"), "\\0303\\0251")),
  (() => assert.eq(plan((z: "last", a: (b: "first"))).nodes.map(n => n.path),
    ("./a", "./a/b", "./z"))),
  (() => assert.eq(plan((a: (b: 4))).error.path, "./a/b")),
  (() => assert.eq(statistics(plan((a: (:), b: "", c: ("link", "x"), d: ("script", "y"))).nodes),
    (total: 4, directories: 1, files: 1, links: 1, scripts: 1, payload-bytes: 2))),
  (() => assert(emit-shell(plan((a: "")).nodes).contains("printf '%b' '' > './a'"))),
  (() => assert(emit-shell(plan((a: ("script", "x"))).nodes).contains("chmod a+x './a'"))),
)
#for check in checks { check() }
#asset("unit-results.json", json.encode((passed: checks.len(), failed: 0)))
