#!/bin/sh
# This adapter transports stdin and executes the program generated by Typst.
# Parsing, validation, traversal, quoting, and code generation live in src/*.typ.
set -eu
mode=apply
case $# in
  0) ;;
  1) case $1 in
       --plan) mode=plan ;;
       --emit) mode=emit ;;
       --help|-h)
         printf '%s\n' 'Usage: json2dir [--plan|--emit] < tree.json' \
           'Default: create entries in the current directory.' \
           '--plan: print the validated JSON operation plan.' \
           '--emit: print the generated shell program without executing it.'
         exit 0 ;;
       *) printf '%s\n' 'Usage: json2dir [--plan|--emit] < tree.json' >&2; exit 1 ;;
     esac ;;
  *) printf '%s\n' 'Usage: json2dir [--plan|--emit] < tree.json' >&2; exit 1 ;;
esac
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/json2dir-typst.XXXXXXXX")
trap 'rm -rf -- "$stage_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$stage_dir/src"
cp "$project_dir/src/lib.typ" "$project_dir/src/main.typ" "$stage_dir/src/"
cat > "$stage_dir/input.json"
typst compile --features bundle --format bundle --root "$stage_dir" \
  --input tree=/input.json "$stage_dir/src/main.typ" "$stage_dir/bundle"
case $mode in
  plan) cat "$stage_dir/bundle/plan.json" ;;
  emit) cat "$stage_dir/bundle/apply.sh" ;;
  apply) /bin/sh "$stage_dir/bundle/apply.sh" ;;
esac
